# ============================================================================
# DebateKit Monorepo - Root Environment
# ============================================================================
#
# WHAT THIS FILE IS:
#   Build/tooling configuration and Cloudflare access tokens that are read
#   from the shell environment (via `process.env`) by scripts that run
#   OUTSIDE the worker runtime — e.g. `drizzle-kit` for D1 Studio,
#   `scripts/clear-r2-cache.ts` for R2 ops, wrangler CLI build flags.
#
# WHAT THIS FILE IS NOT:
#   - NOT loaded by wrangler dev (workers read per-app .dev.vars instead).
#   - NOT a place for runtime app secrets (see apps/*/.dev.vars).
#   - NOT for browser-exposed VITE_* vars (those live in apps/web/.env*).
#
# HOW TO USE:
#   cp .env.example .env
#   Then fill in real values. `.env` is gitignored.
#
# RELATED FILES:
#   - apps/api/.dev.vars.example       — API worker secrets
#   - apps/web/.dev.vars.example       — Web SSR worker secrets (currently none)
#   - apps/mcp/.dev.vars.example       — MCP worker secrets
#   - apps/web/.env                    — Web build-time VITE_* vars (committed)
#   - integrations/*/.dev.vars.example — Per-integration secrets
# ============================================================================


# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Node environment for tooling — `development` locally, `production` in CI.
NODE_ENV=development

# Pinned versions (matched in CI). Used by `engines` checks and Volta/asdf.
NODE_VERSION=22.19.0
PNPM_VERSION=10.10.0

# Verbose logging for build scripts.
VERBOSE=true

# Log level for app code that reads it (`debug`, `info`, `warn`, `error`).
LOG_LEVEL=debug

# Miniflare (local wrangler dev) log level.
MINIFLARE_LOG_LEVEL=debug

# Wrangler build conditions / platform — leave defaults unless debugging bundling.
WRANGLER_BUILD_CONDITIONS=""
WRANGLER_BUILD_PLATFORM="node"


# ============================================================================
# CLOUDFLARE ACCESS
# (Used by drizzle-kit Studio, scripts/clear-r2-cache.ts, manual wrangler ops)
# ============================================================================

# DebateKit's Cloudflare account ID — baked in, do not change.
CLOUDFLARE_ACCOUNT_ID=67bc7b518b92a0c406ac9b8526ddbb6d

# Cloudflare API token with Workers + D1 + R2 permissions.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Account:D1:Edit, Account:Workers R2 Storage:Edit, Account:Workers Scripts:Edit
CLOUDFLARE_API_TOKEN=<get-from-cloudflare-dashboard>

# D1-specific API token used by drizzle-kit to talk to D1 over HTTP.
# Can be the same token as CLOUDFLARE_API_TOKEN if scoped to D1.
D1_TOKEN=<get-from-cloudflare-dashboard>

# D1 database IDs — used by apps/api/drizzle.config.ts when running
# `bun run db:studio:preview` / `bun run db:studio:prod`.
# Find these in `apps/api/wrangler.jsonc` under env.preview.d1_databases / env.production.d1_databases.
PREVIEW_DATABASE_ID=ce0a7c86-7ac5-46c8-bf25-3df0a2345f9c
PROD_DATABASE_ID=74073b18-b9ef-4801-8176-4159905047d1


# ============================================================================
# RUNTIME FALLBACKS (read via process.env in a few code paths)
# ============================================================================

# Base URL of the API worker — used by Better Auth's process.env fallback
# when not running inside the worker (e.g. CLI scripts, type generation).
BETTER_AUTH_URL=http://localhost:8787

# PostHog ingest host — used by tooling that reports build metrics.
POSTHOG_HOST=https://us.i.posthog.com
