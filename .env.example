# DebateKit Monorepo - Root Environment
#
# Copy to .env and fill in values.
#
# PURPOSE:
# - Build/Node configuration
# - Cloudflare access tokens (for D1 Studio, remote ops)
#
# WEB APP VITE_* vars: See apps/web/.env (committed, source of truth)
# API SECRETS: See apps/api/.dev.vars.example

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

NODE_ENV=development
NODE_VERSION=22.19.0
PNPM_VERSION=10.10.0
VERBOSE=true
LOG_LEVEL=debug
MINIFLARE_LOG_LEVEL=debug
WRANGLER_BUILD_CONDITIONS=""
WRANGLER_BUILD_PLATFORM="node"

# ============================================================================
# CLOUDFLARE ACCESS (for D1 Studio, remote database operations)
# ============================================================================

CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
D1_TOKEN=your-d1-token
PREVIEW_DATABASE_ID=your-preview-db-id
PROD_DATABASE_ID=your-prod-db-id

# ============================================================================
# API CONFIG (non-secret, needed for process.env fallback)
# ============================================================================

BETTER_AUTH_URL=http://localhost:8787
POSTHOG_HOST=https://us.i.posthog.com
