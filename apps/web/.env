# Web App Environment Variables (committed - base defaults)
#
# TanStack Start + Vite convention:
# - .env           -> base defaults (committed, always loaded)
# - .env.preview   -> preview overrides (committed, --mode preview)
# - .env.production -> production overrides (committed, default for vite build)
# - .env.local     -> developer overrides (gitignored)
#
# VITE_* vars are statically replaced at build time in the client bundle.
# These are PUBLIC (browser-exposed) -- never put secrets here.
#
# @see https://tanstack.com/start/latest/docs/framework/react/guide/environment-variables

# ============================================================================
# APPLICATION
# ============================================================================

VITE_WEBAPP_ENV=local
VITE_MAINTENANCE=false

# ============================================================================
# THIRD-PARTY PUBLIC KEYS
# ============================================================================

VITE_POSTHOG_API_KEY=phc_j7kkGT8YavyO3VHZMqubY5LXkTk5Y6LqocZn09B9f5O
