{
  "name": "@debatekit/web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bunx vite dev",
    "prebuild": "bun run cf-typegen || true",
    "build": "bunx vite build",
    "build:local": "bunx vite build --mode development",
    "build:preview": "NODE_OPTIONS='--max-old-space-size=4096' bunx vite build --mode preview",
    "build:production": "NODE_OPTIONS='--max-old-space-size=4096' bunx vite build",
    "preview": "bun run build && bunx vite preview",
    "deploy": "bun run build:local && bunx wrangler deploy",
    "deploy:preview": "bun run build:preview && bun run scripts/patch-wrangler-env.ts preview && bunx wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "deploy:production": "bun run build:production && bun run scripts/patch-wrangler-env.ts production && bunx wrangler deploy --config dist/server/wrangler.json --keep-vars",
    "cf-typegen": "bunx wrangler types",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "test": "NODE_OPTIONS='--max-old-space-size=2048' bunx vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=2048' bunx vitest",
    "test:sequential": "NODE_OPTIONS='--max-old-space-size=1024' bunx vitest run --no-file-parallelism --maxWorkers=1",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=2048' CI=true bunx vitest run --maxWorkers=2 --no-file-parallelism",
    "remotion:studio": "bunx remotion studio src/remotion/index.ts --config src/remotion/remotion.config.ts",
    "remotion:render": "bunx remotion render src/remotion/index.ts --config src/remotion/remotion.config.ts",
    "remotion:render:ph": "bunx remotion render src/remotion/index.ts ProductHuntDemo --config src/remotion/remotion.config.ts out/ph-demo.mp4"
  },
  "dependencies": {
    "@ai-sdk-tools/artifacts": "2.0.0-beta.0",
