{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "debatekit-web",
  "account_id": "67bc7b518b92a0c406ac9b8526ddbb6d",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 5173
  },
  "vars": {
    "VITE_WEBAPP_ENV": "local",
    "VITE_MAINTENANCE": "false",
    "VITE_POSTHOG_API_KEY": "phc_j7kkGT8YavyO3VHZMqubY5LXkTk5Y6LqocZn09B9f5O"
  },
  "env": {
    "production": {
      "name": "debatekit-web-prod",
      "workers_dev": false,
      "upload_source_maps": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "routes": [
        {
          "pattern": "debatekit.com/*",
          "zone_name": "debatekit.com"
        },
        {
          "pattern": "www.debatekit.com/*",
          "zone_name": "debatekit.com"
        }
      ],
      "vars": {
        "VITE_WEBAPP_ENV": "prod",
        "VITE_MAINTENANCE": "false",
        "VITE_POSTHOG_API_KEY": "phc_j7kkGT8YavyO3VHZMqubY5LXkTk5Y6LqocZn09B9f5O"
      }
    },
    "preview": {
      "name": "debatekit-web-preview",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "routes": [
        {
          "pattern": "preview.debatekit.com/*",
          "zone_name": "debatekit.com"
        }
      ],
      "vars": {
        "VITE_WEBAPP_ENV": "preview",
        "VITE_MAINTENANCE": "false",
        "VITE_POSTHOG_API_KEY": "phc_j7kkGT8YavyO3VHZMqubY5LXkTk5Y6LqocZn09B9f5O"
      }
    }
  },
  "build": {
    "command": "if [ \"$WORKERS_CI_BRANCH\" = \"main\" ]; then ENV=production; else ENV=preview; fi; cd ../.. && bun install --frozen-lockfile && bun run --filter @debatekit/web build:$ENV && cd apps/web && bun run scripts/patch-wrangler-env.ts $ENV"
  }
}
