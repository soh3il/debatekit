{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "debatekit-api",
  "account_id": "67bc7b518b92a0c406ac9b8526ddbb6d",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "upload_source_maps": false,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "dev": {
    "port": 8787
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "debatekit-dashboard-db-local",
      "database_id": "03f58c3c-85f0-4e7a-9fce-3afacab850d6",
      "migrations_dir": "./src/db/migrations",
      "preview_database_id": "03f58c3c-85f0-4e7a-9fce-3afacab850d6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0ab8201d8a9d43b7ab8e4236026e4811",
      "preview_id": "0ab8201d8a9d43b7ab8e4236026e4811"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "WEBAPP_ENV": "local",
    "APP_NAME": "DebateKit API",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADTGoRlBEUBJ_hEN",
    "R2_PUBLIC_URL": "http://localhost:8787/uploads",
    "AWS_SES_REGION": "eu-north-1",
    "FROM_EMAIL": "noreply@debatekit.com",
    "SES_REPLY_TO_EMAIL": "support@debatekit.com",
    "SES_VERIFIED_EMAIL": "noreply@debatekit.com",
    "STRIPE_CUSTOMER_PORTAL_CONFIG_ID": "bpc_1TZ8iV2R16aMJLB0dK7l4YgN",
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51TZ8Fg2R16aMJLB0nu1rndWh4cDhaOeF049pVhPBegcTeZCWuDfMBKIEqES0GmUtZsU1ZYDme985B0OdYmnQtNfM0052xuVzeI",
    "AUTH_GOOGLE_ID": "965287840257-5637kfaur4mv2m12d3vb5bqccjthcqjm.apps.googleusercontent.com",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "MARKETING_FROM_EMAIL": "hello@mail.debatekit.com",
    "NODE_ENV": "development"
  },
  "env": {
    "production": {
      "name": "debatekit-api-prod",
      "workers_dev": false,
      "upload_source_maps": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "routes": [
        {
          "pattern": "api.debatekit.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "debatekit-dashboard-db-prod",
          "database_id": "280cb89f-c096-417c-a704-ad9b3bdd6d12",
          "migrations_dir": "./src/db/migrations",
          "preview_database_id": "280cb89f-c096-417c-a704-ad9b3bdd6d12"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "0968d7f25e954847a159a00fffc6f677",
          "preview_id": "0968d7f25e954847a159a00fffc6f677"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "triggers": {
        "crons": [
          "*/5 * * * *",
          "0 */12 * * *",
          "0 3 * * *"
        ]
      },
      "vars": {
        "WEBAPP_ENV": "prod",
        "APP_NAME": "DebateKit API",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADTGoRlBEUBJ_hEN",
        "R2_PUBLIC_URL": "https://api.debatekit.com/uploads",
        "AWS_SES_REGION": "eu-north-1",
        "FROM_EMAIL": "noreply@debatekit.com",
        "SES_REPLY_TO_EMAIL": "support@debatekit.com",
        "SES_VERIFIED_EMAIL": "noreply@debatekit.com",
        "STRIPE_CUSTOMER_PORTAL_CONFIG_ID": "bpc_1TZ8iV2R16aMJLB0dK7l4YgN",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51TZ8Fg2R16aMJLB0nu1rndWh4cDhaOeF049pVhPBegcTeZCWuDfMBKIEqES0GmUtZsU1ZYDme985B0OdYmnQtNfM0052xuVzeI",
        "AUTH_GOOGLE_ID": "965287840257-5637kfaur4mv2m12d3vb5bqccjthcqjm.apps.googleusercontent.com",
        "BETTER_AUTH_URL": "https://api.debatekit.com",
        "MARKETING_FROM_EMAIL": "hello@mail.debatekit.com",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "NODE_ENV": "production"
      }
    },
    "preview": {
      "name": "debatekit-api-preview",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "debatekit-dashboard-db-preview",
          "database_id": "685368cd-77f2-424f-b426-490966610e8f",
          "migrations_dir": "./src/db/migrations",
          "preview_database_id": "685368cd-77f2-424f-b426-490966610e8f"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "a9ef1386681c41a58d7136fb676b6b62",
          "preview_id": "a9ef1386681c41a58d7136fb676b6b62"
        }
      ],
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "vars": {
        "WEBAPP_ENV": "preview",
        "APP_NAME": "DebateKit API (preview)",
        "TURNSTILE_SITE_KEY": "0x4AAAAAADTGoRlBEUBJ_hEN",
        "R2_PUBLIC_URL": "https://api-preview.debatekit.com/uploads",
        "AWS_SES_REGION": "eu-north-1",
        "FROM_EMAIL": "noreply@debatekit.com",
        "SES_REPLY_TO_EMAIL": "support@debatekit.com",
        "SES_VERIFIED_EMAIL": "noreply@debatekit.com",
        "STRIPE_CUSTOMER_PORTAL_CONFIG_ID": "bpc_1TZ8iV2R16aMJLB0dK7l4YgN",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51TZ8Fg2R16aMJLB0nu1rndWh4cDhaOeF049pVhPBegcTeZCWuDfMBKIEqES0GmUtZsU1ZYDme985B0OdYmnQtNfM0052xuVzeI",
        "AUTH_GOOGLE_ID": "965287840257-5637kfaur4mv2m12d3vb5bqccjthcqjm.apps.googleusercontent.com",
        "BETTER_AUTH_URL": "https://debatekit.com",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "MARKETING_FROM_EMAIL": "hello@mail.debatekit.com",
        "NODE_ENV": "production"
      }
    }
  }
}
