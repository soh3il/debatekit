{
  "name": "@debatekit/mcp-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx wrangler dev --local --log-level=log --persist-to ../api/.wrangler/state",
    "build:types": "bunx tsc",
    "build": "bun run build:types && bunx wrangler deploy --dry-run --outdir=dist",
    "deploy": "bunx wrangler deploy --define __APP_VERSION__:\\\"$(bun -e \"console.log(require('../../package.json').version)\")\\\"",
    "deploy:preview": "bunx wrangler deploy --env=preview --keep-vars --define __APP_VERSION__:\\\"$(bun -e \"console.log(require('../../package.json').version)\")\\\"",
    "deploy:production": "bunx wrangler deploy --env=production --keep-vars --define __APP_VERSION__:\\\"$(bun -e \"console.log(require('../../package.json').version)\")\\\"",
    "prebuild": "bun run cf-typegen || true",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "cf-typegen": "bunx wrangler types --env-interface Env",
    "test": "bunx vitest run --passWithNoTests",
    "test:watch": "bunx vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.2.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@debatekit/db": "workspace:*",
    "@debatekit/shared": "workspace:*",
    "agents": "^0.6.0",
    "drizzle-orm": "^0.45.1",
    "posthog-node": "^5.24.11",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260122.0",
    "@debatekit/eslint-config": "workspace:*",
    "@debatekit/typescript-config": "workspace:*",
    "@debatekit/vitest-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.60.0"
  }
}
