{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "debatekit-slack-bot",
  "account_id": "67bc7b518b92a0c406ac9b8526ddbb6d",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "upload_source_maps": false,
  "dev": {
    "port": 8790
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "066d627be4c340dda6f298a5e4006ca8",
      "preview_id": "066d627be4c340dda6f298a5e4006ca8"
    }
  ],
  "vars": {
    "DEBATEKIT_API_URL": "http://localhost:8788",
    "DEBATEKIT_APP_URL": "http://localhost:3000"
  },
  "env": {
    "production": {
      "name": "debatekit-slack-bot-prod",
      "workers_dev": false,
      "upload_source_maps": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "routes": [
        {
          "pattern": "slack.debatekit.com",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "066d627be4c340dda6f298a5e4006ca8",
          "preview_id": "066d627be4c340dda6f298a5e4006ca8"
        }
      ],
      "vars": {
        "DEBATEKIT_API_URL": "https://mcp.debatekit.com",
        "DEBATEKIT_APP_URL": "https://debatekit.com"
      }
    },
    "preview": {
      "name": "debatekit-slack-bot-preview",
      "workers_dev": true,
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "02533a5a55af4e169b72491ea2d11948",
          "preview_id": "02533a5a55af4e169b72491ea2d11948"
        }
      ],
      "vars": {
        "DEBATEKIT_API_URL": "https://debatekit-mcp-preview.<account>.workers.dev",
        "DEBATEKIT_APP_URL": "https://debatekit-web-preview.<account>.workers.dev",
        "NODE_ENV": "production"
      }
    }
  },
  "build": {
    "command": "if [ \"$WORKERS_CI_BRANCH\" = \"main\" ]; then ENV=production; else ENV=preview; fi; cd ../.. && bun install --frozen-lockfile && cd integrations/slack && bunx wrangler deploy --env=$ENV --keep-vars"
  }
}
