# ============================================================================
# DebateKit Zapier App — Local Development
# ============================================================================
#
# WHAT THIS FILE IS:
#   Local dev config for the Zapier integration (`debatekit-zapier`,
#   zapier-platform-core app). Used when running `zapier test` locally to
#   exercise triggers, actions, and searches against the live DebateKit API.
#
#   At runtime in Zapier's cloud, the API key comes from the user's Zap
#   credential, NOT this file — this file is only for local test runs.
#
# HOW TO USE:
#   cp .env.example .env
#   Then fill in a real test API key. `.env` is gitignored.
#
# RUNNING TESTS:
#   bun run build
#   zapier test
#
# DEPLOYING:
#   zapier push   (uses .zapierapprc, not this file)
# ============================================================================


# ============================================================================
# DEBATEKIT API CREDENTIAL (for local zapier test only)
# ============================================================================

# DebateKit API key used during `zapier test`.
# Generate at: https://debatekit.ai/settings/api-keys
DEBATEKIT_API_KEY=rpnd_<generate-at-debatekit-settings-api-keys>
