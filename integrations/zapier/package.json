{
  "name": "debatekit-zapier",
  "version": "1.0.0",
  "description": "Zapier integration for DebateKit - collaborative AI brainstorming platform",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "npm run build && jest --testPathPatterns='dist/test'",
