    "push": "npm run build && zapier push"
  },
  "dependencies": {
    "zapier-platform-core": "15.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0",
    "zapier-platform-cli": "15.19.0"
  },
  "private": true
}
