{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "name": "debatekit-whatsapp-bot",
  "account_id": "67bc7b518b92a0c406ac9b8526ddbb6d",
  "compatibility_date": "2026-01-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "upload_source_maps": false,
  "dev": {
    "port": 8792
  },
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "1c62fdcf32c946eaa8ac227c8fb9e31c",
      "preview_id": "1c62fdcf32c946eaa8ac227c8fb9e31c"
    }
  ],
  "vars": {
    "DEBATEKIT_API_URL": "http://localhost:8788",
    "DEBATEKIT_APP_URL": "http://localhost:3000"
  },
  "env": {
    "production": {
      "name": "debatekit-whatsapp-bot-prod",
      "workers_dev": false,
      "upload_source_maps": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1
      },
      "routes": [
        {
          "pattern": "whatsapp.debatekit.com",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "1c62fdcf32c946eaa8ac227c8fb9e31c",
          "preview_id": "1c62fdcf32c946eaa8ac227c8fb9e31c"
        }
      ],
      "vars": {
        "DEBATEKIT_API_URL": "https://mcp.debatekit.com",
        "DEBATEKIT_APP_URL": "https://debatekit.com"
      }
    },
    "preview": {
      "name": "debatekit-whatsapp-bot-preview",
      "workers_dev": true,
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "ea940065d3104456b32dfd79658be698",
          "preview_id": "ea940065d3104456b32dfd79658be698"
        }
      ],
      "vars": {
        "DEBATEKIT_API_URL": "https://debatekit-mcp-preview.<account>.workers.dev",
        "DEBATEKIT_APP_URL": "https://debatekit-web-preview.<account>.workers.dev",
        "NODE_ENV": "production"
      }
    }
  }
}
