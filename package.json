{
  "name": "debatekit",
  "version": "1.5.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/shared",
    "integrations/slack",
    "integrations/telegram",
    "integrations/whatsapp",
    "integrations/zapier"
  ],
  "description": "DebateKit Dashboard - Watch multiple models debate and brainstorm together",
  "author": "DebateKit <soheil@deadpixel.ai>",
  "homepage": "https://debatekit.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/debatekit/dashboard"
  },
  "keywords": [
    "DebateKit",
    "AI collaboration",
    "brainstorming",
    "multiple models",
    "misaligned",
    "cloudflare",
    "cloudflare workers",
    "edge",
    "tanstack-start",
    "dashboard"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*'",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "deploy:preview": "turbo run deploy:preview",
    "deploy:production": "turbo run deploy:production",
    "email:dev": "email dev --dir apps/api/src/emails --port 3001",
    "email:build": "email build --dir apps/api/src/emails --out dist/emails",
    "email:export": "email export --dir apps/api/src/emails --out dist/emails",
    "clean": "rimraf apps/web/.output apps/api/dist .turbo",
    "clean:all": "rimraf node_modules bun.lockb .bun apps/*/node_modules packages/*/node_modules .turbo",
    "cf-typegen": "cd apps/api && bun run cf-typegen && cd ../web && bun run cf-typegen",
    "cf-typegen:check": "cd apps/api && bun run cf-typegen && git diff --exit-code cloudflare-env.d.ts || (echo '⚠️  cloudflare-env.d.ts is out of date. Run bun run cf-typegen and commit.' && exit 1)",
    "generate:icons": "bunx @svgr/cli --memo --ref --typescript --jsx-runtime automatic --prettier-config .prettierrc --out-dir apps/web/src/icons/component --icon --replace-attr-values -- apps/web/src/icons/svg --ignore-existing",
    "preview": "turbo run preview",
    "db:generate": "cd apps/api && bunx drizzle-kit generate",
    "db:migrate:local": "cd apps/api && bunx wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "cd apps/api && bunx wrangler d1 migrations apply DB --remote --env=preview",
    "db:migrate:prod": "cd apps/api && bunx wrangler d1 migrations apply DB --remote --env=production",
    "db:studio:local": "cd apps/api && cross-env WEBAPP_ENV=local bunx drizzle-kit studio",
    "db:studio:preview": "cd apps/api && cross-env WEBAPP_ENV=preview bunx drizzle-kit studio",
    "db:studio:prod": "cd apps/api && cross-env WEBAPP_ENV=prod bunx drizzle-kit studio",
    "remotion:studio": "cd apps/web && bun run remotion:studio",
    "remotion:render": "cd apps/web && bun run remotion:render",
    "remotion:render:ph": "cd apps/web && bun run remotion:render:ph",
    "db:seed:local": "cd apps/api && bunx wrangler d1 execute DB --local --file=./src/db/seed-local.sql",
    "db:seed:preview": "cd apps/api && bunx wrangler d1 execute DB --remote --env=preview --file=./src/db/seed-preview.sql",
    "db:seed:prod": "cd apps/api && bunx wrangler d1 execute DB --remote --env=production --file=./src/db/seed-prod.sql",
    "local:wipe-state": "rm -rf .wrangler/state apps/api/.wrangler/state && echo '✅ Cleared all Wrangler state (D1, R2, KV) from root + apps/api'",
    "local:clear-uploads": "rm -rf .wrangler/state/v3/r2 apps/api/.wrangler/state/v3/r2 .local-uploads/* && (cd apps/api && bunx wrangler d1 execute DB --local --command=\"DELETE FROM project_attachment; DELETE FROM thread_upload; DELETE FROM message_upload; DELETE FROM upload;\" 2>/dev/null || true) && echo '✅ Cleared local uploads (R2 + .local-uploads + DB records)'",
    "db:seed:admin-settings:local": "cd apps/api && bunx wrangler d1 execute DB --local --file=./src/db/seed-admin-settings.sql",
    "db:seed:admin-settings:preview": "cd apps/api && bunx wrangler d1 execute DB --remote --env=preview --file=./src/db/seed-admin-settings.sql",
    "db:seed:admin-settings:prod": "cd apps/api && bunx wrangler d1 execute DB --remote --env=production --file=./src/db/seed-admin-settings.sql",
    "db:full-reset:local": "bun run local:wipe-state && bun run db:migrate:local && bun run db:seed:local && bun run db:seed:admin-settings:local && echo '✅ Database reset complete with seed data'",
    "local:nuclear-reset": "bun run clean && bun run local:wipe-state && bun run db:migrate:local && bun run db:seed:local && bun run db:seed:admin-settings:local && echo '✅ Nuclear reset complete: build cache + all Wrangler state cleared'",
    "prepare": "husky",
    "knip": "knip",
    "i18n:validate": "tsx scripts/validate-translations.ts",
    "i18n:check-unused": "tsx scripts/find-unused-keys.ts",
    "i18n:find-hardcoded": "tsx scripts/find-hardcoded-strings.ts",
    "i18n:check-missing": "tsx scripts/check-missing-translations.ts",
    "i18n:find-missing": "tsx scripts/find-missing-i18n-keys.ts",
    "i18n:add-missing": "tsx scripts/add-missing-i18n-keys.ts",
    "i18n:audit": "tsx scripts/i18n-audit.ts",
    "i18n:fix": "tsx scripts/fix-translations.ts",
    "i18n:full-check": "bun run i18n:validate && bun run i18n:check-unused && bun run i18n:find-hardcoded && bun run i18n:find-missing",
    "test:watch": "turbo run test:watch",
    "test:ui": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest --ui",
    "test:coverage": "turbo run test -- --coverage",
    "test:ci": "turbo run test -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "user:upgrade": "tsx scripts/user-upgrade.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:tag": "changeset tag",
    "release": "turbo run build lint check-types && changeset version",
    "integration:zapier:build": "cd integrations/zapier && bun run build",
    "integration:zapier:validate": "cd integrations/zapier && zapier validate",
    "integration:zapier:push": "cd integrations/zapier && bun run push",
    "integration:n8n:build": "cd integrations/n8n && bun run build",
    "integration:n8n:lint": "cd integrations/n8n && bun run lint",
    "integration:n8n:dev": "cd integrations/n8n && bun run dev",
    "integration:slack:dev": "cd integrations/slack && bun run dev",
    "integration:slack:deploy": "cd integrations/slack && bun run deploy",
    "integration:slack:deploy:preview": "cd integrations/slack && bun run deploy:preview",
    "integration:slack:deploy:production": "cd integrations/slack && bun run deploy:production",
    "integration:clean": "rimraf integrations/zapier/dist integrations/n8n/dist"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.210",
    "@better-auth/api-key": "1.6.20",
    "@better-auth/drizzle-adapter": "^1.6.20",
    "@cloudflare/puppeteer": "^1.1.0",
    "@hono/zod-openapi": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@radix-ui/react-visually-hidden": "^1.2.6",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.9",
    "@remotion/three": "4.0.481",
    "@scalar/hono-api-reference": "^0.11.4",
    "@scalar/openapi-to-markdown": "^0.5.26",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "ai": "^6.0.208",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.20",
    "better-sqlite3": "^12.11.1",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.4.2",
    "hono": "^4.12.26",
    "immer": "^11.1.8",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "nuqs": "^2.8.9",
    "posthog-js": "^1.391.2",
    "posthog-node": "^5.38.2",
    "randomcolor": "^0.6.2",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-email": "6.6.3",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "simplex-noise": "^4.0.3",
    "stoker": "^2.0.1",
    "streamdown": "^2.5.0",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "unified": "^11.0.5",
    "unpdf": "^1.6.2",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@playwright/test": "^1.61.0",
    "@react-email/preview-server": "5.2.10",
    "@sparticuz/chromium": "^149.0.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.0.0",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "jsdom": "^29.1.1",
    "knip": "^6.17.1",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
