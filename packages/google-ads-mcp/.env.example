# ============================================================================
# Google Ads MCP Server — Local Development
# ============================================================================
#
# WHAT THIS FILE IS:
#   Credentials for the standalone Google Ads MCP server (Node.js, runs
#   locally as a stdio MCP server consumed by Claude Desktop, Cursor, etc.).
#   Loaded directly via `process.env` at startup.
#
# HOW TO USE:
#   cp .env.example .env
#   Then fill in real values. `.env` is gitignored.
#
# FIRST-TIME SETUP:
#   1. Fill in CLIENT_ID, CLIENT_SECRET, DEVELOPER_TOKEN, CUSTOMER_ID below.
#   2. Run `bun run setup` to generate REFRESH_TOKEN via the OAuth flow.
#   3. Paste the printed refresh token into GOOGLE_ADS_REFRESH_TOKEN.
#   4. `bun run dev` to start the MCP server.
# ============================================================================


# ============================================================================
# OAUTH2 CLIENT
# (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs)
# ============================================================================

# OAuth2 client ID.
GOOGLE_ADS_CLIENT_ID=<get-from-google-cloud-console-credentials>

# OAuth2 client secret.
GOOGLE_ADS_CLIENT_SECRET=<get-from-google-cloud-console-credentials>

# OAuth2 refresh token — long-lived, used to mint access tokens.
# Generate via: `bun run setup` (runs the OAuth consent + token exchange flow).
GOOGLE_ADS_REFRESH_TOKEN=<run-bun-run-setup-then-paste-here>


# ============================================================================
# GOOGLE ADS API
# ============================================================================

# Developer token — required to call the Google Ads API.
# Get from: https://ads.google.com/aw/apicenter
# Note: new tokens start in Test Account mode; apply for Basic / Standard access for production.
GOOGLE_ADS_DEVELOPER_TOKEN=<get-from-ads-google-com-apicenter>

# Your Google Ads customer ID — 10 digits, NO hyphens.
# Find in: top-right of Google Ads UI (e.g. "123-456-7890" → 1234567890).
GOOGLE_ADS_CUSTOMER_ID=<10-digit-customer-id-no-hyphens>


# ============================================================================
# MANAGER ACCOUNT (optional)
# ============================================================================

# Manager (MCC) account ID — set this ONLY if CUSTOMER_ID above sits under
# a manager account. Same 10-digit-no-hyphens format.
# Leave blank for direct-access accounts.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
