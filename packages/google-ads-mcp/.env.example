# Google Ads MCP Server Configuration
# Copy to .env and fill in your credentials

# OAuth2 credentials (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token (run `bun run setup` to generate)
GOOGLE_ADS_REFRESH_TOKEN=

# Developer token (from https://ads.google.com/aw/apicenter)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Your Google Ads customer ID (10 digits, no hyphens)
GOOGLE_ADS_CUSTOMER_ID=

# Optional: Manager account ID (if using a manager account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
