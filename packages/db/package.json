{
  "name": "@debatekit/db",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tables": {
      "types": "./dist/tables/index.d.ts",
      "import": "./src/tables/index.ts",
      "default": "./src/tables/index.ts"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./src/factory.ts",
      "default": "./src/factory.ts"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./src/services/index.ts",
      "default": "./src/services/index.ts"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bunx tsc",
    "check-types": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix"
  },
  "dependencies": {
    "@debatekit/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260122.0",
    "@debatekit/eslint-config": "workspace:*",
    "@debatekit/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "5.9.3"
  }
}
